@*
    Họ và tên: Phạm Văn Hào
    Mã sinh viên: 23103100041
    Nội dung thực hiện: Module 2 – Tra cứu yêu cầu (§6.5)
*@

@model List<QLThuGomRac_UNETI02_TI17A1HN.Models.Entities.YeuCauThuGom>
@using QLThuGomRac_UNETI02_TI17A1HN.Models.Enums
@{
    ViewData["Title"] = "Yêu cầu của tôi";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Yêu cầu của tôi</h1>

    <a asp-action="Create"
       class="btn btn-primary">
        Đăng ký thu gom
    </a>
</div>

@if (TempData["ThongBao"] is string message)
{
    <div class="alert alert-success" role="status">
        @message
    </div>
}

<div class="request-filter-buttons">

    <a asp-action="Index"
       class="request-filter-btn">
        Toàn bộ lịch sử
    </a>

    <a asp-action="Index"
       asp-route-trangThai="@TrangThaiYeuCau.ChoXacNhan"
       class="request-filter-btn">
        Chờ xác nhận
    </a>

    <a asp-action="Index"
       asp-route-trangThai="@TrangThaiYeuCau.DaXacNhan"
       class="request-filter-btn">
        Đã xác nhận
    </a>

    <a asp-action="Index"
       asp-route-nhom="dang-xu-ly"
       class="request-filter-btn">
        Đang xử lý
    </a>

    <a asp-action="Index"
       asp-route-trangThai="@TrangThaiYeuCau.HoanThanh"
       class="request-filter-btn">
        Hoàn thành
    </a>

    <a asp-action="Index"
       asp-route-nhom="tu-choi-huy"
       class="request-filter-btn">
        Từ chối / Hủy
    </a>

</div>

<form method="get"
      asp-action="Index"
      class="row g-2 align-items-end mb-3">
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <div class="col-md-4">
        <label for="tuKhoa" class="form-label">Mã yêu cầu, địa chỉ hoặc điện thoại</label>
        <input id="tuKhoa" name="tuKhoa" value="@ViewBag.TuKhoa" class="form-control" />
    </div>
    <div class="col-md-4">
        <label for="maKhuVuc" class="form-label">Khu vực</label>
        <select id="maKhuVuc" name="maKhuVuc" class="form-select">
            <option value="">Tất cả</option>
            @foreach (var item in (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.KhuVucs)
            {
                <option value="@item.Value" selected="@(ViewBag.MaKhuVuc?.ToString() == item.Value)">@item.Text</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label for="tuNgay" class="form-label">Ngày thu gom từ</label>
        <input id="tuNgay" name="tuNgay" type="date" value="@ViewBag.TuNgay" class="form-control" />
    </div>
    <div class="col-md-3">
        <label for="denNgay" class="form-label">Đến ngày</label>
        <input id="denNgay" name="denNgay" type="date" value="@ViewBag.DenNgay" class="form-control" />
    </div>
    <div class="col-md-3">
        <label for="sapXep" class="form-label">Sắp xếp</label>
        <select id="sapXep" name="sapXep" class="form-select">
            <option value="">Đăng ký mới nhất</option>
            <option value="ngay-thu-gom" selected="@(ViewBag.SapXep == "ngay-thu-gom")">Ngày thu gom tăng dần</option>
        </select>
    </div>

    <div class="col-md-3">
        <label for="trangThai" class="form-label">
            Trạng thái
        </label>

        <select id="trangThai"
                name="trangThai"
                class="form-select">

            <option value="">Tất cả</option>

            @foreach (var status in Enum.GetValues<TrangThaiYeuCau>())
            {
                <option value="@((int)status)"
                        selected="@(ViewBag.TrangThai == status)">
                    @status.GetDisplayName()
                </option>
            }
        </select>
    </div>

    @if (ViewBag.Nhom != null)
    {
        <input type="hidden"
               name="nhom"
               value="@ViewBag.Nhom" />
    }

    <div class="col-auto">
        <button type="submit"
                class="btn btn-primary">
            Lọc
        </button>
    </div>

    <div class="col-auto">
        <a asp-action="Index"
           class="btn btn-secondary">
            Làm mới
        </a>
    </div>
</form>

@if (ViewBag.Nhom == "dang-xu-ly")
{
    <p>
        Đang xem: yêu cầu đã phân công hoặc đang thu gom.
    </p>
}

@if (ViewBag.Nhom == "tu-choi-huy")
{
    <p>
        Đang xem: yêu cầu từ chối hoặc hủy.
    </p>
}

<div class="table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Mã</th>
                <th>Ngày đăng ký</th>
                <th>Ngày thu gom</th>
                <th>Khung giờ</th>
                <th>Khu vực</th>
                <th>Trạng thái</th>
                <th>Chức năng</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var request in Model)
            {
                <tr>
                    <td>@request.MaYeuCau</td>
                    <td>@request.NgayDangKy.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@request.NgayMongMuonThuGom.ToString("dd/MM/yyyy")</td>
                    <td>@request.KhungGio</td>
                    <td>@request.KhuVuc.TenKhuVuc</td>
                    <td>@request.TrangThai.GetDisplayName()</td>

                    <td>
                        <a asp-action="Details"
                           asp-route-id="@request.MaYeuCau"
                           class="btn btn-sm btn-info">
                            Chi tiết
                        </a>
                        @if (request.TrangThai == TrangThaiYeuCau.ChoXacNhan)
                        {
                            <form asp-action="Huy" asp-route-id="@request.MaYeuCau" method="post" class="d-inline"
                                  onsubmit="return confirm('Bạn có chắc muốn hủy yêu cầu này không?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Hủy</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<p>Tổng số: @ViewBag.TongSo yêu cầu — Trang @ViewBag.Trang / @ViewBag.SoTrang</p>
@if (ViewBag.SoTrang > 1)
{
    <nav aria-label="Phân trang yêu cầu" class="d-flex gap-2">
        @for (var pageNumber = Math.Max(1, (int)ViewBag.Trang - 2); pageNumber <= Math.Min((int)ViewBag.SoTrang, (int)ViewBag.Trang + 2); pageNumber++)
        {
            <a asp-action="Index" asp-route-trang="@pageNumber"
               asp-route-tuKhoa="@ViewBag.TuKhoa" asp-route-maKhuVuc="@ViewBag.MaKhuVuc"
               asp-route-tuNgay="@ViewBag.TuNgay" asp-route-denNgay="@ViewBag.DenNgay"
               asp-route-trangThai="@ViewBag.TrangThai" asp-route-nhom="@ViewBag.Nhom"
               asp-route-sapXep="@ViewBag.SapXep"
               class="btn @(pageNumber == (int)ViewBag.Trang ? "btn-primary" : "btn-outline-primary")">@pageNumber</a>
        }
    </nav>
}

@if (Model.Count == 0)
{
    <p class="text-muted">
        Chưa có yêu cầu phù hợp.
    </p>
}
