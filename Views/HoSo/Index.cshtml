@*
    Họ và tên: Phạm Văn Hào
    Mã sinh viên: 23103100041
    Nội dung thực hiện: Module 2 – Thông tin cá nhân (§6.1)
*@

@model QLThuGomRac_UNETI02_TI17A1HN.Models.ViewModels.Module2.HoSoViewModel
@using QLThuGomRac_UNETI02_TI17A1HN.Models.Enums

@{
    ViewData["Title"] = "Thông tin cá nhân";
}

<div class="page-header-section">

    <div>
        <div class="page-title-icon">
            <i class="bi bi-person-vcard-fill"></i>
        </div>

        <div>
            <h1>Thông tin cá nhân</h1>
            <p>Xem và cập nhật thông tin hồ sơ của bạn.</p>
        </div>
    </div>

</div>


<div class="form-page-card">

    <div class="form-card-header">

        <div>
            <h2>Hồ sơ người dân</h2>
            <p>Cập nhật các thông tin cá nhân bên dưới.</p>
        </div>

        <div class="form-card-icon">
            <i class="bi bi-person-fill"></i>
        </div>

    </div>


    <form asp-action="Index"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>


        <div class="row g-4">

            <div class="col-md-6">

                <label asp-for="HoTen"
                       class="form-label">
                    Họ và tên
                </label>

                <div class="input-group">

                    <span class="input-group-text">
                        <i class="bi bi-person-fill"></i>
                    </span>

                    <input asp-for="HoTen"
                           class="form-control"
                           placeholder="Nhập họ và tên" />

                </div>

                <span asp-validation-for="HoTen"
                      class="text-danger">
                </span>

            </div>


            <div class="col-md-6">

                <label asp-for="NgaySinh"
                       class="form-label">
                    Ngày sinh
                </label>

                <div class="input-group">

                    <span class="input-group-text">
                        <i class="bi bi-calendar-event"></i>
                    </span>

                    <input asp-for="NgaySinh"
                           type="date"
                           class="form-control" />

                </div>

                <span asp-validation-for="NgaySinh"
                      class="text-danger">
                </span>

            </div>


            <div class="col-md-6">

                <label asp-for="GioiTinh"
                       class="form-label">
                    Giới tính
                </label>

                <select asp-for="GioiTinh"
                        class="form-select">

                    <option value="">
                        -- Chọn giới tính --
                    </option>

                    @foreach (var gender in Enum.GetValues<GioiTinh>())
                    {
                        <option value="@((int)gender)">
                            @gender.GetDisplayName()
                        </option>
                    }

                </select>

                <span asp-validation-for="GioiTinh"
                      class="text-danger">
                </span>

            </div>


            <div class="col-md-6">

                <label asp-for="SoDienThoai"
                       class="form-label">
                    Số điện thoại
                </label>

                <div class="input-group">

                    <span class="input-group-text">
                        <i class="bi bi-telephone-fill"></i>
                    </span>

                    <input asp-for="SoDienThoai"
                           class="form-control"
                           placeholder="Nhập số điện thoại" />

                </div>

                <span asp-validation-for="SoDienThoai"
                      class="text-danger">
                </span>

            </div>


            <div class="col-md-6">

                <label asp-for="Email"
                       class="form-label">
                    Email
                </label>

                <div class="input-group">

                    <span class="input-group-text">
                        <i class="bi bi-envelope-fill"></i>
                    </span>

                    <input asp-for="Email"
                           class="form-control"
                           placeholder="Nhập email" />

                </div>

                <span asp-validation-for="Email"
                      class="text-danger">
                </span>

            </div>


            <div class="col-md-6">

                <label class="form-label">
                    Trạng thái
                </label>

                <div class="form-control bg-light">
                    <i class="bi bi-circle-fill text-success me-2"></i>
                    @ViewBag.TrangThai
                </div>

            </div>


            <div class="col-12">

                <label asp-for="DiaChi"
                       class="form-label">
                    Địa chỉ
                </label>

                <div class="input-group">

                    <span class="input-group-text">
                        <i class="bi bi-geo-alt-fill"></i>
                    </span>

                    <textarea asp-for="DiaChi"
                              class="form-control"
                              rows="3"
                              placeholder="Nhập địa chỉ"></textarea>

                </div>

                <span asp-validation-for="DiaChi"
                      class="text-danger">
                </span>

            </div>

        </div>


        <div class="mt-4 pt-3 border-top">

            <button type="submit"
                    class="btn btn-success">

                <i class="bi bi-check-circle-fill"></i>
                Lưu thay đổi

            </button>

        </div>

    </form>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}
