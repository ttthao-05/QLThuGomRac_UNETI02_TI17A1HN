@{
    ViewData["Title"] = "Trang chủ";

    var maTaiKhoan = Context.Session.GetInt32("MaTaiKhoan");
    var vaiTro = Context.Session.GetString("VaiTro");
}

<div class="home-page">

    <!--HERO-->
    <section class="hero-panel">

        <div class="hero-content">

            <h1>Vì một môi trường xanh – sạch – đẹp</h1>

            <p>
                Quản lý thu gom rác tái chế hiệu quả,
                chung tay xây dựng cộng đồng bền vững.
            </p>

            @if (vaiTro == "NguoiDan")
            {
                <a asp-controller="YeuCauThuGom"
                   asp-action="Create"
                   class="btn btn-success hero-action-button">

                    <i class="bi bi-calendar-check"></i>
                    Đăng ký lịch thu gom

                </a>
            }

        </div>

    </section>

    <!-- TIÊU ĐỀ -->
    <div class="home-section-header">
        <div>
            <h2>Chức năng hệ thống</h2>
            <p>Các nhóm chức năng chính của hệ thống thu gom rác tái chế.</p>
        </div>
    </div>


    <!-- CHỨC NĂNG -->
    <div class="row g-4">

        <div class="row g-4">

            <!-- NGƯỜI DÂN -->
            <div class="col-12 col-md-6 col-xl-3">
                <div class="quick-card">
                    <div class="quick-card-title">
                        <div class="quick-card-icon">
                            <i class="bi bi-person-fill"></i>
                        </div>
                        <h3>Người dân</h3>
                    </div>
                    <p>
                        Xem thông tin thu gom, đăng ký lịch và theo dõi yêu cầu.
                    </p>
                </div>
            </div>


            <!-- NHÂN VIÊN -->
            <div class="col-12 col-md-6 col-xl-3">
                <div class="quick-card">
                    <div class="quick-card-title">
                        <div class="quick-card-icon">
                            <i class="bi bi-person-workspace"></i>
                        </div>
                        <h3>Nhân viên</h3>
                    </div>
                    <p>
                        Tiếp nhận công việc được phân công và cập nhật kết quả thu gom.
                    </p>
                </div>
            </div>


            <!-- QUẢN TRỊ -->
            <div class="col-12 col-md-6 col-xl-3">
                <div class="quick-card">
                    <div class="quick-card-title">
                        <div class="quick-card-icon">
                            <i class="bi bi-shield-lock-fill"></i>
                        </div>
                        <h3>Quản trị</h3>
                    </div>
                    <p>
                        Quản lý tài khoản, khu vực, loại rác và người dân.
                    </p>
                    @if (vaiTro == "Admin")
                    {
                        <a asp-controller="TaiKhoan"
                           asp-action="Index"
                           class="quick-link">
                            Mở quản trị
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    }
                </div>
            </div>


            <!-- THỐNG KÊ -->
            <div class="col-12 col-md-6 col-xl-3">
                <div class="quick-card">
                    <div class="quick-card-title">
                        <div class="quick-card-icon">
                            <i class="bi bi-bar-chart-fill"></i>
                        </div>
                        <h3>Thống kê</h3>
                    </div>
                    <p>
                        Theo dõi yêu cầu, kết quả thu gom và tổng hợp số liệu.
                    </p>
                </div>
            </div>
        </div>


    <!-- THÔNG TIN BỔ SUNG -->
    <section class="home-info-section">

        <div class="home-info-item">
            <div class="home-info-icon">
                <i class="bi bi-calendar-check-fill"></i>
            </div>

            <div>
                <strong>Đăng ký thuận tiện</strong>
                <span>Người dân chủ động lựa chọn lịch thu gom phù hợp.</span>
            </div>
        </div>

        <div class="home-info-item">
            <div class="home-info-icon">
                <i class="bi bi-geo-alt-fill"></i>
            </div>

            <div>
                <strong>Quản lý theo khu vực</strong>
                <span>Thông tin thu gom được tổ chức rõ ràng theo từng khu vực.</span>
            </div>
        </div>

        <div class="home-info-item">
            <div class="home-info-icon">
                <i class="bi bi-arrow-repeat"></i>
            </div>

            <div>
                <strong>Theo dõi trạng thái</strong>
                <span>Cập nhật và theo dõi quá trình xử lý yêu cầu thu gom.</span>
            </div>
        </div>

    </section>

</div>
