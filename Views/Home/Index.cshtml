@{
    ViewData["Title"] = "Trang chủ";
}

<div class="text-center mb-4">
    <h1 class="display-5">Hệ thống quản lý thu gom rác tái chế</h1>
    <p class="lead">Ứng dụng đăng ký lịch thu gom và theo dõi kết quả thu gom.</p>
</div>

<div class="row g-3">
    <div class="col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Người dân</h5>
                <p class="card-text">Đăng nhập, xem thông tin và đăng ký lịch thu gom.</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Nhân viên</h5>
                <p class="card-text">Xem công việc được phân công và cập nhật kết quả.</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Quản trị</h5>
                <p class="card-text">Quản lý danh mục, yêu cầu, phân công và nhân viên.</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Thống kê</h5>
                <p class="card-text">Theo dõi yêu cầu, kết quả và tổng hợp khối lượng.</p>
            </div>
        </div>
    </div>
</div>
