@*
    Họ và tên: Trần Thị Thảo
    Mã sinh viên: 23103100025
    Nội dung thực hiện: Module 1 – Trang chủ phía người dân
*@

@{
    ViewData["Title"] = "Trang chủ";
    var hoTen = Context.Session.GetString("HoTen");
}

<div class="page-header-section">
    <div>
        <div class="page-title-icon">
            <i class="bi bi-house-door-fill"></i>
        </div>

        <div>
            <h1>Trang chủ</h1>
            <p>Xin chào @hoTen! Chào mừng bạn đến với hệ thống thu gom rác tái chế.</p>
        </div>
    </div>
</div>

<div class="row g-4">

    <div class="col-md-6">
        <div class="page-card h-100">
            <h4>
                <i class="bi bi-recycle me-2"></i>
                Loại rác phục vụ
            </h4>

            <p>
                Xem các loại rác tái chế hiện đang được hệ thống tiếp nhận.
            </p>

            <a asp-controller="ThongTinThuGom"
               asp-action="LoaiRac"
               class="btn btn-success">
                Xem loại rác
            </a>
        </div>
    </div>

    <div class="col-md-6">
        <div class="page-card h-100">
            <h4>
                <i class="bi bi-map-fill me-2"></i>
                Khu vực phục vụ
            </h4>

            <p>
                Xem các khu vực hiện đang hỗ trợ dịch vụ thu gom.
            </p>

            <a asp-controller="ThongTinThuGom"
               asp-action="KhuVuc"
               class="btn btn-success">
                Xem khu vực
            </a>
        </div>
    </div>

    <div class="col-md-6">
        <div class="page-card h-100">
            <h4>
                <i class="bi bi-calendar-plus-fill me-2"></i>
                Đăng ký thu gom
            </h4>

            <p>
                Tạo yêu cầu thu gom rác tái chế tại địa chỉ của bạn.
            </p>

            <a asp-controller="YeuCauThuGom"
               asp-action="Create"
               class="btn btn-success">
                Đăng ký ngay
            </a>
        </div>
    </div>

    <div class="col-md-6">
        <div class="page-card h-100">
            <h4>
                <i class="bi bi-list-check me-2"></i>
                Yêu cầu của tôi
            </h4>

            <p>
                Theo dõi trạng thái và lịch sử các yêu cầu đã đăng ký.
            </p>

            <a asp-controller="YeuCauThuGom"
               asp-action="Index"
               class="btn btn-success">
                Xem yêu cầu
            </a>
        </div>
    </div>

</div>
