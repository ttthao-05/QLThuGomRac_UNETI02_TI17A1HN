@* Nguyễn Tiến Đạt – 23103100053 – Module 3, mục 7.2 *@
@*
    Họ và tên: Trần Thị Thảo
    Mã sinh viên: 23103100025
    Nội dung thực hiện: Bổ sung giao diện nút Từ chối yêu cầu
*@

@model List<QLThuGomRac_UNETI02_TI17A1HN.Models.Entities.YeuCauThuGom>
@using QLThuGomRac_UNETI02_TI17A1HN.Models.Entities

@{
    ViewData["Title"] = "Phân công thu gom";

    var choXacNhan = ViewBag.YeuCauChoXacNhan
        as List<YeuCauThuGom> ?? new List<YeuCauThuGom>();
}

<h1>Phân công thu gom</h1>

@if (TempData["ThongBao"] is string thongBao)
{
    <div class="alert alert-success">@thongBao</div>
}

@if (TempData["Loi"] is string loi)
{
    <div class="alert alert-danger">@loi</div>
}

<h2 class="mt-4">Yêu cầu chờ xác nhận (@choXacNhan.Count)</h2>

@if (choXacNhan.Count == 0)
{
    <div class="alert alert-info">
        Không có yêu cầu đang chờ xác nhận.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered align-middle">
            <thead>
                <tr>
                    <th>Mã yêu cầu</th>
                    <th>Khu vực</th>
                    <th>Địa chỉ</th>
                    <th>Ngày thu gom</th>
                    <th>Khung giờ</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in choXacNhan)
                {
                    <tr>
                        <td>@item.MaYeuCau</td>
                        <td>@item.KhuVuc?.TenKhuVuc</td>
                        <td>@item.DiaChiThuGom</td>
                        <td>@item.NgayMongMuonThuGom.ToString("dd/MM/yyyy")</td>
                        <td>@item.KhungGio</td>
                        <td class="d-flex gap-2">
                            <form asp-controller="PhanCong"
                                  asp-action="XacNhan"
                                  method="post">
                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@item.MaYeuCau" />

                                <button type="submit"
                                        class="btn btn-success btn-sm">
                                    Xác nhận
                                </button>
                            </form>

                            <form asp-controller="PhanCong"
                                  asp-action="TuChoi"
                                  method="post"
                                  onsubmit="return confirm('Bạn có chắc muốn từ chối yêu cầu này không?');">
                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@item.MaYeuCau" />

                                <button type="submit"
                                        class="btn btn-danger btn-sm">
                                    Từ chối
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<h2 class="mt-4">Yêu cầu chờ phân công (@Model.Count)</h2>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        Không có yêu cầu đã xác nhận đang chờ phân công.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered align-middle">
            <thead>
                <tr>
                    <th>Mã yêu cầu</th>
                    <th>Khu vực</th>
                    <th>Địa chỉ</th>
                    <th>Ngày thu gom</th>
                    <th>Khung giờ</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.MaYeuCau</td>
                        <td>@item.KhuVuc?.TenKhuVuc</td>
                        <td>@item.DiaChiThuGom</td>
                        <td>@item.NgayMongMuonThuGom.ToString("dd/MM/yyyy")</td>
                        <td>@item.KhungGio</td>
                        <td>
                            <a asp-controller="PhanCong"
                               asp-action="Create"
                               asp-route-id="@item.MaYeuCau"
                               class="btn btn-primary btn-sm">
                                Phân công
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
