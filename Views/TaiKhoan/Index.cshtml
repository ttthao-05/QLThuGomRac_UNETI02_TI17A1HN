@*
    Họ và tên: Trần Thị Thảo
    Mã sinh viên: 23103100025
    Nội dung thực hiện: Module 1 – Quản lý tài khoản (§5.1 Quản lý tài khoản)
*@

@using QLThuGomRac_UNETI02_TI17A1HN.Models.Entities
@using QLThuGomRac_UNETI02_TI17A1HN.Models.Enums
@using QLThuGomRac_UNETI02_TI17A1HN.Models.ViewModels.Module1
@model TaiKhoanIndexViewModel

@{
    ViewData["Title"] = "Quản lý tài khoản";
}

<div class="page-header-section">
    <div>
        <div class="page-title-icon">
            <i class="bi bi-person-gear"></i>
        </div>

        <div>
            <h1>Quản lý tài khoản</h1>
            <p>
                Xem danh sách, tìm kiếm, thêm, sửa và quản lý trạng thái tài khoản.
            </p>
        </div>
    </div>

    <a asp-controller="TaiKhoan"
       asp-action="Create"
       class="btn btn-success">

        <i class="bi bi-person-plus-fill"></i>
        Thêm tài khoản
    </a>
</div>



<!-- TÌM KIẾM VÀ LỌC -->
<div class="filter-card">

    <div class="filter-card-title">
        <i class="bi bi-funnel-fill"></i>
        Tìm kiếm và lọc
    </div>

    <form asp-controller="TaiKhoan"
          asp-action="Index"
          method="get"
          class="row g-3 align-items-end">

        <div class="col-lg-4 col-md-6">
            <label asp-for="TuKhoa"
                   class="form-label">
                Từ khóa
            </label>

            <div class="input-icon-group">
                <i class="bi bi-search"></i>

                <input asp-for="TuKhoa"
                       class="form-control"
                       placeholder="Tên đăng nhập hoặc họ tên" />
            </div>
        </div>


        <div class="col-lg-3 col-md-6">
            <label asp-for="LoaiTaiKhoan"
                   class="form-label">
                Loại tài khoản
            </label>

            <select name="LoaiTaiKhoan"
                    class="form-select"
                    asp-items="Model.LoaiTaiKhoanItems">
            </select>
        </div>


        <div class="col-lg-3 col-md-6">
            <label asp-for="TrangThai"
                   class="form-label">
                Trạng thái
            </label>

            <select name="TrangThai"
                    class="form-select"
                    asp-items="Model.TrangThaiItems">
            </select>
        </div>


        <div class="col-lg-2 col-md-6">
            <div class="d-flex gap-2">

                <button type="submit"
                        class="btn btn-primary flex-fill">

                    <i class="bi bi-search"></i>
                    Tìm
                </button>

                <a asp-controller="TaiKhoan"
                   asp-action="Index"
                   class="btn btn-outline-secondary"
                   title="Đặt lại">

                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>

            </div>
        </div>

    </form>

</div>


<!-- DANH SÁCH -->
<div class="page-card">

    <div class="table-header">

        <div>
            <h2>Danh sách tài khoản</h2>

            <span>
                Tổng số:
                <strong>@Model.DanhSach.Count</strong>
                tài khoản
            </span>
        </div>

    </div>


    @if (Model.DanhSach.Count == 0)
    {
        <div class="empty-state">

            <div class="empty-state-icon">
                <i class="bi bi-person-x"></i>
            </div>

            <h3>Không tìm thấy tài khoản</h3>

            <p>
                Không có tài khoản phù hợp với điều kiện tìm kiếm hoặc lọc.
            </p>

            <a asp-controller="TaiKhoan"
               asp-action="Index"
               class="btn btn-outline-primary">

                Đặt lại bộ lọc
            </a>

        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table admin-table mb-0">

                <thead>
                    <tr>
                        <th>Mã</th>
                        <th>Tên đăng nhập</th>
                        <th>Họ tên</th>
                        <th>Số điện thoại</th>
                        <th>Loại tài khoản</th>
                        <th>Trạng thái</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model.DanhSach)
                    {
                        <tr>

                            <td>
                                <span class="table-id">
                                    #@item.MaTaiKhoan
                                </span>
                            </td>


                            <td>
                                <div class="account-cell">

                                    <div class="account-avatar">
                                        <i class="bi bi-person-fill"></i>
                                    </div>

                                    <strong>
                                        @item.TenDangNhap
                                    </strong>

                                </div>
                            </td>


                            <td>
                                @item.HoTen
                            </td>


                            <td>
                                @item.SoDienThoai
                            </td>


                            <td>
                                <span class="account-type-badge">
                                    @item.LoaiTaiKhoan.GetDisplayName()
                                </span>
                            </td>


                            <td>

                                @if (item.TrangThai == TrangThaiTaiKhoan.DangHoatDong)
                                {
                                    <span class="status-badge status-success">

                                        <i class="bi bi-circle-fill"></i>
                                        @item.TrangThai.GetDisplayName()

                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-danger">

                                        <i class="bi bi-circle-fill"></i>
                                        @item.TrangThai.GetDisplayName()

                                    </span>
                                }

                            </td>


                            <td>

                                <div class="table-actions">

                                    <a asp-controller="TaiKhoan"
                                       asp-action="Details"
                                       asp-route-id="@item.MaTaiKhoan"
                                       class="action-button action-view"
                                       title="Xem chi tiết">

                                        <i class="bi bi-eye"></i>
                                    </a>


                                    <a asp-controller="TaiKhoan"
                                       asp-action="Edit"
                                       asp-route-id="@item.MaTaiKhoan"
                                       class="action-button action-edit"
                                       title="Chỉnh sửa">

                                        <i class="bi bi-pencil-square"></i>
                                    </a>


                                    <form asp-controller="TaiKhoan"
                                          asp-action="KhoaMoKhoa"
                                          asp-route-id="@item.MaTaiKhoan"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        @if (item.TrangThai == TrangThaiTaiKhoan.DangHoatDong)
                                        {
                                            <button type="submit"
                                                    class="action-button action-lock"
                                                    title="Khóa tài khoản"
                                                    onclick="return confirm('Khóa tài khoản @item.TenDangNhap?');">

                                                <i class="bi bi-lock-fill"></i>

                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit"
                                                    class="action-button action-unlock"
                                                    title="Mở khóa tài khoản"
                                                    onclick="return confirm('Mở khóa tài khoản @item.TenDangNhap?');">

                                                <i class="bi bi-unlock-fill"></i>

                                            </button>
                                        }

                                    </form>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>
