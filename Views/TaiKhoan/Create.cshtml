@* // Họ và tên: Trần Thị Thảo
   // Mã sinh viên: 23103100025
   // Nội dung thực hiện: Module 1 – Quản lý tài khoản (§5.1 Quản lý tài khoản) *@
@using QLThuGomRac_UNETI02_TI17A1HN.Models.ViewModels.Module1
@model TaiKhoanCreateViewModel
@{
    ViewData["Title"] = "Thêm tài khoản";
}

<h1 class="mb-3">Thêm tài khoản</h1>

<div class="row">
    <div class="col-md-7">
        <form asp-controller="TaiKhoan" asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="mb-3">
                <label asp-for="TenDangNhap" class="form-label"></label>
                <input asp-for="TenDangNhap" class="form-control" />
                <span asp-validation-for="TenDangNhap" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MatKhau" class="form-label"></label>
                <input asp-for="MatKhau" class="form-control" />
                <span asp-validation-for="MatKhau" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="HoTen" class="form-label"></label>
                <input asp-for="HoTen" class="form-control" />
                <span asp-validation-for="HoTen" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="SoDienThoai" class="form-label"></label>
                <input asp-for="SoDienThoai" class="form-control" />
                <span asp-validation-for="SoDienThoai" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="LoaiTaiKhoan" class="form-label"></label>
                <select asp-for="LoaiTaiKhoan" asp-items="Model.LoaiTaiKhoanItems" class="form-select"></select>
                <span asp-validation-for="LoaiTaiKhoan" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="TrangThai" class="form-label"></label>
                <select asp-for="TrangThai" asp-items="Model.TrangThaiItems" class="form-select"></select>
                <span asp-validation-for="TrangThai" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-success">Thêm tài khoản</button>
            <a asp-controller="TaiKhoan" asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
