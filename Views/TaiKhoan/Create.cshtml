@*
    Họ và tên: Trần Thị Thảo
    Mã sinh viên: 23103100025
    Nội dung thực hiện: Module 1 – Quản lý tài khoản (§5.1 Quản lý tài khoản)
*@

@using QLThuGomRac_UNETI02_TI17A1HN.Models.ViewModels.Module1
@model TaiKhoanCreateViewModel

@{
    ViewData["Title"] = "Thêm tài khoản";
}

<div class="page-header-section">
    <div>
        <div class="page-title-icon">
            <i class="bi bi-person-plus-fill"></i>
        </div>

        <div>
            <h1>Thêm tài khoản</h1>
            <p>Tạo mới tài khoản sử dụng trong hệ thống.</p>
        </div>
    </div>

    <a asp-controller="TaiKhoan"
        asp-action="Index"
        class="btn btn-success">
        <i class="bi bi-arrow-left"></i>
            Quay lại
    </a>
</div>

<div class="form-page-card">

    <div class="form-card-header">
        <div>
            <h2>Thông tin tài khoản</h2>
            <p>Nhập đầy đủ các thông tin bên dưới.</p>
        </div>

        <div class="form-card-icon">
            <i class="bi bi-person-vcard"></i>
        </div>
    </div>

    <form asp-controller="TaiKhoan"
          asp-action="Create"
          method="post">

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger validation-summary-errors">
        </div>

        <div class="row g-4">

            <!-- Tên đăng nhập -->
            <div class="col-md-6">
                <label asp-for="TenDangNhap"
                       class="form-label">
                    Tên đăng nhập
                </label>

                <div class="input-icon-group">
                    <i class="bi bi-person"></i>

                    <input asp-for="TenDangNhap"
                           class="form-control"
                           placeholder="Nhập tên đăng nhập" />
                </div>

                <span asp-validation-for="TenDangNhap"
                      class="text-danger">
                </span>
            </div>

            <!-- Mật khẩu -->
            <div class="col-md-6">
                <label asp-for="MatKhau"
                       class="form-label">
                    Mật khẩu
                </label>

                <div class="input-icon-group">
                    <i class="bi bi-lock"></i>

                    <input asp-for="MatKhau"
                           class="form-control"
                           placeholder="Nhập mật khẩu" />
                </div>

                <span asp-validation-for="MatKhau"
                      class="text-danger">
                </span>
            </div>

            <!-- Họ tên -->
            <div class="col-md-6">
                <label asp-for="HoTen"
                       class="form-label">
                    Họ tên
                </label>

                <div class="input-icon-group">
                    <i class="bi bi-person-badge"></i>

                    <input asp-for="HoTen"
                           class="form-control"
                           placeholder="Nhập họ và tên" />
                </div>

                <span asp-validation-for="HoTen"
                      class="text-danger">
                </span>
            </div>

            <!-- Số điện thoại -->
            <div class="col-md-6">
                <label asp-for="SoDienThoai"
                       class="form-label">
                    Số điện thoại
                </label>

                <div class="input-icon-group">
                    <i class="bi bi-telephone"></i>

                    <input asp-for="SoDienThoai"
                           class="form-control"
                           placeholder="Nhập số điện thoại" />
                </div>

                <span asp-validation-for="SoDienThoai"
                      class="text-danger">
                </span>
            </div>

            <!-- Loại tài khoản -->
            <div class="col-md-6">
                <label asp-for="LoaiTaiKhoan"
                       class="form-label">
                    Loại tài khoản
                </label>

                <select asp-for="LoaiTaiKhoan"
                        asp-items="Model.LoaiTaiKhoanItems"
                        class="form-select">
                </select>

                <span asp-validation-for="LoaiTaiKhoan"
                      class="text-danger">
                </span>
            </div>

            <!-- Trạng thái -->
            <div class="col-md-6">
                <label asp-for="TrangThai"
                       class="form-label">
                    Trạng thái
                </label>

                <select asp-for="TrangThai"
                        asp-items="Model.TrangThaiItems"
                        class="form-select">
                </select>

                <span asp-validation-for="TrangThai"
                      class="text-danger">
                </span>
            </div>

        </div>

        <div class="form-actions">
            <button type="submit"
                    class="btn btn-success">
                <i class="bi bi-check-circle-fill"></i>
                Thêm tài khoản
            </button>
        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
