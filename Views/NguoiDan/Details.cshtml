@* Họ và tên: Phạm Văn Hào | Mã sinh viên: 23103100041 | Nội dung thực hiện: Module 2 – Chi tiết người dân (§6.1) *@
@model QLThuGomRac_UNETI02_TI17A1HN.Models.Entities.NguoiDan
@using QLThuGomRac_UNETI02_TI17A1HN.Models.Enums
@{ ViewData["Title"] = "Chi tiết người dân"; }
<h1>Chi tiết người dân #@Model.MaNguoiDan</h1>
@if (TempData["ThongBao"] is string message) { <div class="alert alert-success" role="status">@message</div> }
<dl class="row">
    <dt class="col-sm-3">Tài khoản</dt><dd class="col-sm-9">@Model.TaiKhoan.TenDangNhap (#@Model.MaTaiKhoan)</dd>
    <dt class="col-sm-3">Họ tên</dt><dd class="col-sm-9">@Model.HoTen</dd>
    <dt class="col-sm-3">Ngày sinh</dt><dd class="col-sm-9">@(Model.NgaySinh?.ToString("dd/MM/yyyy") ?? "Chưa cung cấp")</dd>
    <dt class="col-sm-3">Giới tính</dt><dd class="col-sm-9">@(Model.GioiTinh?.GetDisplayName() ?? "Chưa cung cấp")</dd>
    <dt class="col-sm-3">Điện thoại</dt><dd class="col-sm-9">@Model.SoDienThoai</dd>
    <dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd>
    <dt class="col-sm-3">Địa chỉ</dt><dd class="col-sm-9">@Model.DiaChi</dd>
    <dt class="col-sm-3">Ngày đăng ký</dt><dd class="col-sm-9">@Model.NgayDangKy.ToString("dd/MM/yyyy HH:mm")</dd>
    <dt class="col-sm-3">Trạng thái</dt><dd class="col-sm-9">@Model.TrangThai.GetDisplayName()</dd>
</dl>
<form asp-action="CapNhatTrangThai" asp-route-id="@Model.MaNguoiDan" method="post" class="d-flex gap-2 mb-3">
    <label for="trangThai" class="visually-hidden">Trạng thái</label><select id="trangThai" name="trangThai" class="form-select w-auto">@foreach (var status in Enum.GetValues<TrangThaiNguoiDan>()) { <option value="@((int)status)" selected="@(Model.TrangThai == status)">@status.GetDisplayName()</option> }</select>
    <button class="btn btn-primary">Cập nhật trạng thái</button>
</form>
<a asp-action="Index">Về danh sách</a>
