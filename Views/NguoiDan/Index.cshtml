@*
    Họ và tên: Phạm Văn Hào
    Mã sinh viên: 23103100041
    Nội dung thực hiện: Module 2 – Danh sách người dân (§6.1)
*@

@model List<QLThuGomRac_UNETI02_TI17A1HN.Models.Entities.NguoiDan>

@using QLThuGomRac_UNETI02_TI17A1HN.Models.Enums

@{
    ViewData["Title"] = "Quản lý người dân";
}

<h1 class="mb-3">Quản lý người dân</h1>

<form method="get" class="row g-2 mb-4">

    <div class="col-md-6">
        <label for="tuKhoa" class="form-label">
            Tìm theo họ tên, điện thoại, email
        </label>

        <input id="tuKhoa"
               name="tuKhoa"
               value="@ViewBag.TuKhoa"
               class="form-control"
               placeholder="Nhập từ khóa cần tìm..." />
    </div>

    <div class="col-md-4">
        <label for="trangThai" class="form-label">
            Trạng thái
        </label>

        <select id="trangThai"
                name="trangThai"
                class="form-select">

            <option value="">Tất cả</option>

            @foreach (var status in Enum.GetValues<TrangThaiNguoiDan>())
            {
                <option value="@((int)status)"
                        selected="@(ViewBag.TrangThai == status)">
                    @status.GetDisplayName()
                </option>
            }

        </select>
    </div>

    <div class="col-md-2 align-self-end d-flex gap-2">

        <button type="submit"
                class="btn btn-primary">
            <i class="bi bi-search"></i>
            Tìm kiếm
        </button>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-clockwise"></i>
        </a>

    </div>

</form>


<div class="table-responsive">

    <table class="table table-striped table-hover align-middle">

        <thead>
            <tr>
                <th>Mã</th>
                <th>Họ tên</th>
                <th>Điện thoại</th>
                <th>Email</th>
                <th>Trạng thái</th>
                <th class="text-center">Chức năng</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var person in Model)
            {
                <tr>

                    <td>
                        @person.MaNguoiDan
                    </td>

                    <td>
                        @person.HoTen
                    </td>

                    <td>
                        @person.SoDienThoai
                    </td>

                    <td>
                        @person.Email
                    </td>

                    <td>
                        @person.TrangThai.GetDisplayName()
                    </td>

                    <td class="text-center">

                        <a asp-action="Details"
                           asp-route-id="@person.MaNguoiDan"
                           class="btn-detail-cyan">
                            Chi tiết
                        </a>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>


@if (Model.Count == 0)
{
    <div class="alert alert-info mt-3">
        Không tìm thấy người dân phù hợp.
    </div>
}
