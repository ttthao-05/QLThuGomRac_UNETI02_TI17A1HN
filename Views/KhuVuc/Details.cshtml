@*
    Họ và tên: Trần Thị Thảo
    Mã sinh viên: 23103100025
    Nội dung thực hiện: Module 1 – Quản lý khu vực (§5.5)
*@

@using QLThuGomRac_UNETI02_TI17A1HN.Models.Enums
@model QLThuGomRac_UNETI02_TI17A1HN.Models.Entities.KhuVuc

@{
    ViewData["Title"] = "Chi tiết khu vực";
}

<div class="page-header-section">

    <div>
        <div class="page-title-icon">
            <i class="bi bi-geo-alt-fill"></i>
        </div>

        <div>
            <h1>
                Chi tiết khu vực
                <span class="edit-account-id">#@Model.MaKhuVuc</span>
            </h1>

            <p>Xem thông tin khu vực phục vụ thu gom.</p>
        </div>
    </div>

    <a asp-action="Index"
       class="btn btn-success">

        <i class="bi bi-arrow-left"></i>
        Quay lại

    </a>

</div>


<div class="detail-card">

    <div class="detail-card-header">

        <div class="detail-user">

            <div class="detail-avatar">
                <i class="bi bi-geo-alt-fill"></i>
            </div>

            <div>
                <h2>@Model.TenKhuVuc</h2>
                <span>Khu vực thu gom</span>
            </div>

        </div>


        @if (Model.TrangThai == TrangThaiKhuVuc.DangHoatDong)
        {
            <span class="status-badge status-success">

                <i class="bi bi-circle-fill"></i>
                Đang hoạt động

            </span>
        }
        else
        {
            <span class="status-badge status-danger">

                <i class="bi bi-circle-fill"></i>
                Ngừng hoạt động

            </span>
        }

    </div>


    <div class="detail-grid">

        <!-- Mã khu vực -->
        <div class="detail-item">

            <div class="detail-item-icon">
                <i class="bi bi-hash"></i>
            </div>

            <div>
                <span>Mã khu vực</span>
                <strong>#@Model.MaKhuVuc</strong>
            </div>

        </div>


        <!-- Tên khu vực -->
        <div class="detail-item">

            <div class="detail-item-icon">
                <i class="bi bi-map"></i>
            </div>

            <div>
                <span>Tên khu vực</span>
                <strong>@Model.TenKhuVuc</strong>
            </div>

        </div>


        <!-- Địa chỉ -->
        <div class="detail-item detail-item-full">

            <div class="detail-item-icon">
                <i class="bi bi-geo"></i>
            </div>

            <div>
                <span>Địa chỉ mô tả</span>
                <strong>
                    @(string.IsNullOrWhiteSpace(Model.DiaChiMoTa)
                        ? "Chưa cập nhật"
                        : Model.DiaChiMoTa)
                </strong>
            </div>

        </div>


        <!-- Trạng thái -->
        <div class="detail-item detail-item-full">

            <div class="detail-item-icon">
                <i class="bi bi-activity"></i>
            </div>

            <div>
                <span>Trạng thái hoạt động</span>

                @if (Model.TrangThai == TrangThaiKhuVuc.DangHoatDong)
                {
                    <strong class="text-success">
                        Đang hoạt động
                    </strong>
                }
                else
                {
                    <strong class="text-danger">
                        Ngừng hoạt động
                    </strong>
                }

            </div>

        </div>

    </div>


    <div class="detail-actions">

        <a asp-action="Edit"
           asp-route-id="@Model.MaKhuVuc"
           class="btn btn-success">

            <i class="bi bi-pencil-square"></i>
            Chỉnh sửa khu vực

        </a>


    </div>

</div>
