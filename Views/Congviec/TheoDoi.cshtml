@* Nguyễn Tiến Đạt – 23103100053
   Module 3 – Xử lý yêu cầu thu gom (7.3) *@

@using QLThuGomRac_UNETI02_TI17A1HN.Models.Enums
@model List<QLThuGomRac_UNETI02_TI17A1HN.Models.Entities.PhanCongThuGom>

@{
    ViewData["Title"] = "Theo dõi công việc";
}

<h2 class="mb-3">Theo dõi công việc thu gom</h2>

<div class="mb-3">
    <a asp-controller="PhanCong"
       asp-action="Index"
       class="btn btn-primary">
        Phân công thu gom
    </a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        Chưa có công việc được phân công.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Mã yêu cầu</th>
                    <th>Nhân viên phụ trách</th>
                    <th>Địa chỉ thu gom</th>
                    <th>Khu vực</th>
                    <th>Trạng thái</th>
                    <th>Bắt đầu</th>
                    <th>Kết thúc</th>
                    <th>Lý do không thực hiện được</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.MaYeuCau</td>

                        <td>
                            <div>@item.NhanVien?.HoTen</div>
                            <small class="text-muted">
                                @item.NhanVien?.SoDienThoai
                            </small>
                        </td>

                        <td>@item.YeuCauThuGom?.DiaChiThuGom</td>

                        <td>
                            @item.YeuCauThuGom?.KhuVuc?.TenKhuVuc
                        </td>

                        <td>@item.TrangThai.GetDisplayName()</td>

                        <td>
                            @(item.NgayBatDau?.ToString("dd/MM/yyyy HH:mm")
                                ?? "Chưa bắt đầu")
                        </td>

                        <td>
                            @(item.NgayKetThuc?.ToString("dd/MM/yyyy HH:mm")
                                ?? "Chưa kết thúc")
                        </td>

                        <td style="min-width: 200px; white-space: pre-wrap;">@(string.IsNullOrWhiteSpace(item.LyDoKhongThucHien) ? "—" : item.LyDoKhongThucHien)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
