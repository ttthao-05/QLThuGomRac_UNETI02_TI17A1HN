@*
    Họ và tên: Vũ Đức Hải
    Mã sinh viên: 23103100008
    Nội dung thực hiện: Module 4 - Giao diện theo dõi yêu cầu
*@

@using QLThuGomRac_UNETI02_TI17A1HN.Helpers
@model QLThuGomRac_UNETI02_TI17A1HN.ViewModels.TheoDoiYeuCauVM

@{
    ViewData["Title"] = "Theo dõi yêu cầu thu gom";
    var f = Model.Filter;
}

<link rel="stylesheet"href="~/css/module4-modern.css"asp-append-version="true" />

<div class="m4-page">

    <!--1. TIÊU ĐỀ TRANG-->
    <div class="m4-header">

        <div>
            <div class="m4-kicker">Theo dõi & thống kê</div>

            <h1><i class="bi bi-clipboard-data me-2"></i>
                Theo dõi yêu cầu thu gom
            </h1>

            <p class="m4-subtitle">Tìm kiếm, lọc và xem tiến độ xử lýyêu cầu của người dân</p>
        </div>

        <a class="m4-btn m4-btn-outline"asp-controller="Dashboard"asp-action="Index">
            <i class="bi bi-speedometer2"></i>
            Dashboard
        </a>

    </div>


    <!--2. BỘ LỌC YÊU CẦU-->
    <section class="m4-panel">
        <div class="m4-panel-title">
            <i class="bi bi-funnel"></i>
            Bộ lọc yêu cầu
        </div>

        <form method="get"asp-action="Index" class="m4-filters">

            <!-- Tìm kiếm -->
            <div class="m4-field m4-search">
                <label for="m4-keyword">Mã yêu cầu / người dân</label>
                <input id="m4-keyword" name="TuKhoa" value="@f.TuKhoa"
                       class="form-control" placeholder="Tìm mã YC hoặc họ tên" />
            </div>

            <!-- Lọc khu vực -->
            <div class="m4-field">
                <label for="m4-area">Khu vực</label>
                <select id="m4-area" name="MaKhuVuc"
                        class="form-select" asp-items="Model.KhuVucs">
                    <option value=""> Tất cả khu vực</option>
                </select>
            </div>


            <!-- Lọc trạng thái -->
            <div class="m4-field">
                <label for="m4-state">Trạng thái</label>
                <select id="m4-state"name="TrangThai"
                        class="form-select"asp-items="Model.TrangThais">
                    <option value="">Tất cả trạng thái</option>
                </select>
            </div>


            <!-- Lọc nhân viên -->
            <div class="m4-field">
                <label for="m4-staff">Nhân viên</label>
                <select id="m4-staff"name="MaNhanVien"
                        class="form-select"asp-items="Model.NhanViens">
                    <option value="">Tất cả nhân viên</option>
                </select>
            </div>


            <!-- Từ ngày -->
            <div class="m4-field m4-date">
                <label for="m4-from">Từ ngày</label>
                <input id="m4-from"name="TuNgay"type="date"
                       class="form-control"value="@f.TuNgay?.ToString("yyyy-MM-dd")" />
            </div>


            <!-- Đến ngày -->
            <div class="m4-field m4-date">
                <label for="m4-to">Đến ngày</label>
                <input id="m4-to"name="DenNgay"type="date"
                       class="form-control"value="@f.DenNgay?.ToString("yyyy-MM-dd")" />
            </div>


            <!-- Nút lọc -->
            <div class="m4-actions">
                <a asp-action="Index"
                   class="m4-btn m4-btn-outline">
                    <i class="bi bi-arrow-counterclockwise"></i>Xóa lọc
                </a>

                <button type="submit"class="m4-btn">
                    <i class="bi bi-search"></i> Lọc kết quả</button>
            </div>
        </form>
    </section>


    <!--3. DANH SÁCH YÊU CẦU-->
    <section class="m4-panel">
        <!-- Tiêu đề danh sách -->
        <div class="m4-header">
            <div class="m4-panel-title mb-0">
                <i class="bi bi-list-ul"></i>Danh sách yêu cầu
            </div>

            <span class="m4-subtitle">Tổng cộng:
                <strong>@Model.Data.TotalItems</strong>yêu cầu
            </span>
        </div>


        <!-- Bảng danh sách -->
        <div class="m4-table-wrap">
            <table class="m4-table">
                <thead>
                    <tr>
                        <th>Mã</th>
                        <th>Người dân</th>
                        <th>Khu vực</th>
                        <th>Nhân viên</th>
                        <th>Ngày mong muốn</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>

                    @foreach (var r in Model.Data.Items)
                    {
                        // Lấy tên trạng thái
                        var trangThai = r.TrangThai.TenHienThi();

                        // Xác định màu theo trạng thái
                        var css =  trangThai.Contains("Hoàn thành") ? "m4-status-done"
                            : trangThai.Contains("Chờ") ? "m4-status-pending"

                            : (
                                trangThai.Contains("Đang")
                                || trangThai.Contains("Đã phân công") || trangThai.Contains("Đã xác nhận")
                              ) ? "m4-status-running"

                            : (
                                trangThai.Contains("Từ chối")
                                || trangThai.Contains("Hủy") || trangThai.Contains("Không thực hiện")
                              ) ? "m4-status-cancel"

                            : "m4-status-neutral";
                        <tr>
                            <!-- Mã yêu cầu -->
                            <td class="m4-id">#@r.MaYeuCau</td>

                            <!-- Người dân -->
                            <td>@r.NguoiDan</td>

                            <!-- Khu vực -->
                            <td>@r.KhuVuc</td>

                            <!-- Nhân viên -->
                            <td>@(r.NhanVien ?? "Chưa phân công")</td>

                            <!-- Ngày mong muốn -->
                            <td>@r.NgayMongMuon.ToString("dd/MM/yyyy")</td>

                            <!-- Trạng thái -->
                            <td><span class="m4-status @css"> @trangThai</span></td>

                            <!-- Xem chi tiết -->
                            <td>
                                <a asp-action="Details"asp-route-id="@r.MaYeuCau"
                                   class="m4-btn m4-btn-outline" style="min-height:31px; padding:4px 9px;">
                                    <i class="bi bi-eye"></i>Chi tiết
                                </a>
                            </td>
                        </tr>
                    }


                    <!-- Không có dữ liệu -->
                    @if (!Model.Data.Items.Any())
                    {
                        <tr>
                            <td colspan="7"class="m4-empty">
                                <i class="bi bi-inbox me-2"></i>Không tìm thấy yêu cầu phù hợp.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>


        <!-- 4. PHÂN TRANG -->
        <div class="m4-page-footer">
            <span class="m4-subtitle">
                Trang @Model.Data.Page / @Math.Max(1, Model.Data.TotalPages)
            </span>

            <nav aria-label="Phân trang yêu cầu">
                <ul class="pagination">
                    @for (int p = 1; p <= Model.Data.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.Data.Page ? "active" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@p"
                               asp-route-TuKhoa="@f.TuKhoa"
                               asp-route-MaKhuVuc="@f.MaKhuVuc"
                               asp-route-TrangThai="@f.TrangThai"
                               asp-route-MaNhanVien="@f.MaNhanVien"
                               asp-route-TuNgay="@f.TuNgay?.ToString("yyyy-MM-dd")"
                               asp-route-DenNgay="@f.DenNgay?.ToString("yyyy-MM-dd")">
                                @p
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    </section>
</div>
