@model QLThuGomRac_UNETI02_TI17A1HN.Models.Entities.LoaiRac

@{
    ViewData["Title"] = "Sửa loại rác";
}

<h2>Sửa loại rác</h2>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden"
           asp-for="MaLoaiRac" />

    <div asp-validation-summary="ModelOnly"
         class="text-danger">
    </div>

    <div class="mb-3">
        <label asp-for="TenLoaiRac"
               class="form-label"></label>

        <input asp-for="TenLoaiRac"
               class="form-control" />

        <span asp-validation-for="TenLoaiRac"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DonViTinh"
               class="form-label"></label>

        <input asp-for="DonViTinh"
               class="form-control" />

        <span asp-validation-for="DonViTinh"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="MoTa"
               class="form-label"></label>

        <textarea asp-for="MoTa"
                  class="form-control"
                  rows="3"></textarea>

        <span asp-validation-for="MoTa"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="TrangThai"
               class="form-label"></label>

        <select asp-for="TrangThai"
                class="form-select"
                asp-items="Html.GetEnumSelectList<QLThuGomRac_UNETI02_TI17A1HN.Models.Enums.TrangThaiLoaiRac>()">
        </select>
    </div>

    <button type="submit"
            class="btn btn-primary">
        Lưu thay đổi
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Quay lại
    </a>
</form>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
