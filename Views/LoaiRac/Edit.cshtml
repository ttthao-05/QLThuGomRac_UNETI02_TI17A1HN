@*
    Họ và tên: Trần Thị Thảo
    Mã sinh viên: 23103100025
    Nội dung thực hiện: Module 1 – Quản lý loại rác (§5.6)
*@

@model QLThuGomRac_UNETI02_TI17A1HN.Models.Entities.LoaiRac

@{
    ViewData["Title"] = "Sửa loại rác";
}

<div class="page-header-section">

    <div>
        <div class="page-title-icon">
            <i class="bi bi-pencil-square"></i>
        </div>

        <div>
            <h1>
                Sửa loại rác
                <span class="edit-account-id">#@Model.MaLoaiRac</span>
            </h1>

            <p>Cập nhật thông tin loại rác tái chế trong hệ thống.</p>
        </div>
    </div>

    <a asp-action="Index"
       class="btn btn-success">

        <i class="bi bi-arrow-left"></i>
        Quay lại

    </a>

</div>


<div class="form-page-card">

    <div class="form-card-header">

        <div>
            <h2>Thông tin loại rác</h2>
            <p>Chỉnh sửa các thông tin cần thiết bên dưới.</p>
        </div>

        <div class="form-card-icon">
            <i class="bi bi-recycle"></i>
        </div>

    </div>


    <form asp-action="Edit"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden"
               asp-for="MaLoaiRac" />

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger validation-summary-errors">
        </div>


        <div class="row g-4">

            <!-- Tên loại rác -->
            <div class="col-md-6">

                <label asp-for="TenLoaiRac"
                       class="form-label">
                    Tên loại rác
                </label>

                <div class="input-icon-group">

                    <i class="bi bi-recycle"></i>

                    <input asp-for="TenLoaiRac"
                           class="form-control"
                           placeholder="Ví dụ: Nhựa, Giấy, Kim loại..." />

                </div>

                <span asp-validation-for="TenLoaiRac"
                      class="text-danger">
                </span>

            </div>


            <!-- Đơn vị tính -->
            <div class="col-md-6">

                <label asp-for="DonViTinh"
                       class="form-label">
                    Đơn vị tính
                </label>

                <div class="input-icon-group">

                    <i class="bi bi-box-seam"></i>

                    <input asp-for="DonViTinh"
                           class="form-control"
                           placeholder="Ví dụ: kg" />

                </div>

                <span asp-validation-for="DonViTinh"
                      class="text-danger">
                </span>

            </div>


            <!-- Mô tả -->
            <div class="col-12">

                <label asp-for="MoTa"
                       class="form-label">
                    Mô tả
                </label>

                <textarea asp-for="MoTa"
                          class="form-control"
                          rows="4"
                          placeholder="Nhập mô tả ngắn về loại rác này"></textarea>

                <span asp-validation-for="MoTa"
                      class="text-danger">
                </span>

            </div>


            <!-- Trạng thái -->
            <div class="col-md-6">

                <label asp-for="TrangThai"
                       class="form-label">
                    Trạng thái
                </label>

                <select asp-for="TrangThai"
                        class="form-select"
                        asp-items="Html.GetEnumSelectList<QLThuGomRac_UNETI02_TI17A1HN.Models.Enums.TrangThaiLoaiRac>()">
                </select>

                <span asp-validation-for="TrangThai"
                      class="text-danger">
                </span>

            </div>

        </div>


        <div class="form-actions">

            <button type="submit"
                    class="btn btn-success">

                <i class="bi bi-check-circle-fill"></i>
                Lưu thay đổi

            </button>

        </div>

    </form>

</div>


@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
