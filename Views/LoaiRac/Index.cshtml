@*
    Họ và tên: Trần Thị Thảo
    Mã sinh viên: 23103100025
    Nội dung thực hiện: Module 1 – Quản lý loại rác (§5.6)
*@

@using QLThuGomRac_UNETI02_TI17A1HN.Models.Enums
@model IEnumerable<QLThuGomRac_UNETI02_TI17A1HN.Models.Entities.LoaiRac>

@{
    ViewData["Title"] = "Quản lý loại rác";
}

<div class="page-header-section">

    <div>
        <div class="page-title-icon">
            <i class="bi bi-trash3-fill"></i>
        </div>

        <div>
            <h1>Quản lý loại rác</h1>
            <p>Quản lý các loại rác tái chế đang được hệ thống phục vụ.</p>
        </div>
    </div>

    <a asp-action="Create"
       class="btn btn-success">

        <i class="bi bi-plus-circle-fill"></i>
        Thêm loại rác

    </a>

</div>

@if (TempData["Loi"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show"
         role="alert">

        <i class="bi bi-exclamation-triangle-fill me-1"></i>
        @TempData["Loi"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


<!-- TÌM KIẾM -->
<div class="filter-card">

    <div class="filter-card-title">
        <i class="bi bi-search"></i>
        Tìm kiếm loại rác
    </div>

    <form method="get"
          asp-action="Index"
          class="row g-3 align-items-end">

        <div class="col-lg-7 col-md-8">

            <label class="form-label">
                Tên loại rác
            </label>

            <div class="input-icon-group">

                <i class="bi bi-search"></i>

                <input type="text"
                       name="tuKhoa"
                       value="@ViewBag.TuKhoa"
                       class="form-control"
                       placeholder="Nhập tên loại rác cần tìm..." />

            </div>

        </div>


        <div class="col-lg-5 col-md-4">

            <div class="d-flex gap-2">

                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-search"></i>
                    Tìm kiếm

                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">

                    <i class="bi bi-arrow-counterclockwise"></i>
                    Làm mới

                </a>

            </div>

        </div>

    </form>

</div>


<!-- DANH SÁCH -->
<div class="page-card">

    <div class="table-header">

        <div>
            <h2>Danh sách loại rác</h2>
            <span>
                Tổng số:
                <strong>@Model.Count()</strong>
                loại rác
            </span>
        </div>

    </div>


    @if (!Model.Any())
    {
        <div class="empty-state">

            <div class="empty-state-icon">
                <i class="bi bi-trash3"></i>
            </div>

            <h3>Không tìm thấy loại rác</h3>

            <p>
                Không có loại rác phù hợp với từ khóa tìm kiếm.
            </p>

            <a asp-action="Index"
               class="btn btn-outline-primary">

                <i class="bi bi-arrow-counterclockwise"></i>
                Đặt lại tìm kiếm

            </a>

        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table admin-table mb-0">

                <thead>
                    <tr>
                        <th>Mã</th>
                        <th>Tên loại rác</th>
                        <th>Đơn vị tính</th>
                        <th>Mô tả</th>
                        <th>Trạng thái</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                <span class="table-id">
                                    #@item.MaLoaiRac
                                </span>
                            </td>


                            <td>

                                <div class="waste-name-cell">

                                    <div class="waste-icon">
                                        <i class="bi bi-recycle"></i>
                                    </div>

                                    <strong>
                                        @item.TenLoaiRac
                                    </strong>

                                </div>

                            </td>


                            <td>
                                <span class="account-type-badge">
                                    @item.DonViTinh
                                </span>
                            </td>


                            <td>
                                <span class="table-description">
                                    @(string.IsNullOrWhiteSpace(item.MoTa)
                                        ? "Chưa có mô tả"
                                        : item.MoTa)
                                </span>
                            </td>


                            <td>

                                @if (item.TrangThai == TrangThaiLoaiRac.DangPhucVu)
                                {
                                    <span class="status-badge status-success">

                                        <i class="bi bi-circle-fill"></i>
                                        Đang phục vụ

                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-danger">

                                        <i class="bi bi-circle-fill"></i>
                                        Ngừng phục vụ

                                    </span>
                                }

                            </td>


                            <td>

                                <div class="table-actions">

                                    <a asp-action="Details"
                                       asp-route-id="@item.MaLoaiRac"
                                       class="action-button action-view"
                                       title="Xem chi tiết">

                                        <i class="bi bi-eye"></i>

                                    </a>


                                    <a asp-action="Edit"
                                       asp-route-id="@item.MaLoaiRac"
                                       class="action-button action-edit"
                                       title="Chỉnh sửa">

                                        <i class="bi bi-pencil-square"></i>

                                    </a>


                                    <form asp-action="CapNhatTrangThai"
                                          asp-route-id="@item.MaLoaiRac"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="action-button action-status"
                                                title="Đổi trạng thái"
                                                onclick="return confirm('Bạn có chắc muốn đổi trạng thái loại rác này không?');">

                                            <i class="bi bi-arrow-repeat"></i>

                                        </button>

                                    </form>


                                    <form asp-action="Delete"
                                          asp-route-id="@item.MaLoaiRac"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Bạn có chắc muốn xóa loại rác này không?');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="action-button action-delete"
                                                title="Xóa">

                                            <i class="bi bi-trash3"></i>

                                        </button>

                                    </form>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>
