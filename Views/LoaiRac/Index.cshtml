@model IEnumerable<QLThuGomRac_UNETI02_TI17A1HN.Models.Entities.LoaiRac>

@{
    ViewData["Title"] = "Quản lý loại rác";
}

<h2>Quản lý loại rác</h2>

@if (TempData["ThongBao"] != null)
{
    <div class="alert alert-success">
        @TempData["ThongBao"]
    </div>
}

@if (TempData["Loi"] != null)
{
    <div class="alert alert-danger">
        @TempData["Loi"]
    </div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">
        Thêm loại rác
    </a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Mã</th>
            <th>Tên loại rác</th>
            <th>Đơn vị tính</th>
            <th>Mô tả</th>
            <th>Trạng thái</th>
            <th>Chức năng</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.MaLoaiRac</td>
                <td>@item.TenLoaiRac</td>
                <td>@item.DonViTinh</td>
                <td>@item.MoTa</td>

                <td>
                    @if (item.TrangThai ==
                        QLThuGomRac_UNETI02_TI17A1HN.Models.Enums.TrangThaiLoaiRac.DangPhucVu)
                    {
                        <span>Đang phục vụ</span>
                    }
                    else
                    {
                        <span>Ngừng phục vụ</span>
                    }
                </td>

                <td>
                    <a asp-action="Details"
                       asp-route-id="@item.MaLoaiRac"
                       class="btn btn-info btn-sm">
                        Chi tiết
                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@item.MaLoaiRac"
                       class="btn btn-warning btn-sm">
                        Sửa
                    </a>

                    <form asp-action="CapNhatTrangThai"
                          asp-route-id="@item.MaLoaiRac"
                          method="post"
                          style="display:inline">
                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-secondary btn-sm">
                            Đổi trạng thái
                        </button>
                    </form>

                    <form asp-action="Delete"
                          asp-route-id="@item.MaLoaiRac"
                          method="post"
                          style="display:inline"
                          onsubmit="return confirm('Bạn có chắc muốn xóa loại rác này không?');">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-danger btn-sm">
                            Xóa
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
