@*
    Họ tên: Trần Thị Thảo
    Msv: 23103100025
    ND: Module 1 – Giao diện đăng nhập (§5.2)
*@

@model QLThuGomRac_UNETI02_TI17A1HN.Models.ViewModels.Module1.LoginViewModel

@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="login-page">

    <div class="login-card">

        <!-- GIỚI THIỆU HỆ THỐNG -->
        <div class="login-intro">

            <div class="login-intro-icon">
                <i class="bi bi-recycle"></i>
            </div>

            <h2>QLThuGomRac</h2>

            <p>
                Hệ thống quản lý thu gom rác tái chế,
                hỗ trợ người dân đăng ký và theo dõi quá trình thu gom.
            </p>

            <div class="login-feature">
                <i class="bi bi-check-circle-fill"></i>
                <span>Đăng ký lịch thu gom thuận tiện</span>
            </div>

            <div class="login-feature">
                <i class="bi bi-check-circle-fill"></i>
                <span>Theo dõi trạng thái yêu cầu</span>
            </div>

            <div class="login-feature">
                <i class="bi bi-check-circle-fill"></i>
                <span>Quản lý thông tin tập trung</span>
            </div>

        </div>


        <!-- FORM ĐĂNG NHẬP -->
        <div class="login-form-area">

            <div class="login-form-header">
                <h1>Đăng nhập</h1>
                <p>Vui lòng nhập thông tin tài khoản để tiếp tục.</p>
            </div>

            <form asp-controller="Account"
                  asp-action="Login"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <!-- TÊN ĐĂNG NHẬP -->
                <div class="mb-3">

                    <label asp-for="TenDangNhap"
                           class="form-label">
                        Tên đăng nhập
                    </label>

                    <div class="input-icon-group">

                        <i class="bi bi-person"></i>

                        <input asp-for="TenDangNhap"
                               class="form-control"
                               placeholder="Nhập tên đăng nhập"
                               autocomplete="username" />

                    </div>

                    <span asp-validation-for="TenDangNhap"
                          class="text-danger">
                    </span>

                </div>


                <!-- MẬT KHẨU -->
                <div class="mb-4">

                    <label asp-for="MatKhau"
                           class="form-label">
                        Mật khẩu
                    </label>

                    <div class="input-icon-group">

                        <i class="bi bi-lock"></i>

                        <input asp-for="MatKhau"
                               class="form-control"
                               placeholder="Nhập mật khẩu"
                               autocomplete="current-password" />

                    </div>

                    <span asp-validation-for="MatKhau"
                          class="text-danger">
                    </span>

                </div>


                <!-- NÚT ĐĂNG NHẬP -->
                <button type="submit"
                        class="btn btn-success login-submit">

                    <i class="bi bi-box-arrow-in-right"></i>
                    Đăng nhập

                </button>

            </form>


            <div class="login-back">

                <a asp-controller="Home"
                   asp-action="Index">

                    <i class="bi bi-arrow-left"></i>
                    Quay lại trang chủ

                </a>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
