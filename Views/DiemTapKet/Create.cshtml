@*
    Họ và tên: Trần Thị Thảo
    Mã sinh viên: 23103100025
    Nội dung thực hiện: Module 1 – Quản lý điểm tập kết
*@

@model QLThuGomRac_UNETI02_TI17A1HN.Models.Entities.DiemTapKet

@{
    ViewData["Title"] = "Thêm điểm tập kết";
}

<div class="page-header-section">

    <div>
        <div class="page-title-icon">
            <i class="bi bi-pin-map-fill"></i>
        </div>

        <div>
            <h1>Thêm điểm tập kết</h1>
            <p>Thêm điểm tập kết rác tái chế mới.</p>
        </div>
    </div>

    <a asp-action="Index"
       class="btn btn-success">

        <i class="bi bi-arrow-left"></i>
        Quay lại

    </a>

</div>

<div class="form-page-card">

    <form asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger">
        </div>

        <div class="row g-4">

            <div class="col-md-6">

                <label asp-for="TenDiemTapKet"
                       class="form-label">
                </label>

                <input asp-for="TenDiemTapKet"
                       class="form-control"
                       placeholder="Nhập tên điểm tập kết" />

                <span asp-validation-for="TenDiemTapKet"
                      class="text-danger">
                </span>

            </div>

            <div class="col-md-6">

                <label asp-for="MaKhuVuc"
                       class="form-label">
                </label>

                <select asp-for="MaKhuVuc"
                        asp-items="ViewBag.MaKhuVuc"
                        class="form-select">

                    <option value="">
                        -- Chọn khu vực --
                    </option>

                </select>

                <span asp-validation-for="MaKhuVuc"
                      class="text-danger">
                </span>

            </div>

            <div class="col-12">

                <label asp-for="DiaChi"
                       class="form-label">
                </label>

                <input asp-for="DiaChi"
                       class="form-control"
                       placeholder="Nhập địa chỉ điểm tập kết" />

                <span asp-validation-for="DiaChi"
                      class="text-danger">
                </span>

            </div>

            <div class="col-12">

                <label asp-for="MoTa"
                       class="form-label">
                </label>

                <textarea asp-for="MoTa"
                          class="form-control"
                          rows="3"
                          placeholder="Nhập mô tả">
                </textarea>

                <span asp-validation-for="MoTa"
                      class="text-danger">
                </span>

            </div>

            <div class="col-md-6">

                <label asp-for="TrangThai"
                       class="form-label">
                </label>

                <select asp-for="TrangThai"
                        class="form-select"
                        asp-items="Html.GetEnumSelectList<QLThuGomRac_UNETI02_TI17A1HN.Models.Enums.TrangThaiDiemTapKet>()">
                </select>

            </div>

        </div>

        <div class="form-actions">

            <button type="submit"
                    class="btn btn-success">

                <i class="bi bi-check-circle-fill"></i>
                Thêm điểm tập kết

            </button>

        </div>

    </form>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
